{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Project Life",
        "width": 1440,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 16 },
        "dragDropEnabled": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
